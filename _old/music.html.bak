<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>音乐品味测试 - 一宅一句</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f0f1a 100%);
            min-height: 100vh;
            color: #fff;
        }
        header { padding: 20px; text-align: center; background: rgba(0,0,0,0.3); }
        header h1 {
            font-size: 1.5rem;
            background: linear-gradient(90deg, #a8edea, #fed6e3);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .container { max-width: 600px; margin: 0 auto; padding: 30px 20px; }
        .back-link { display: inline-block; color: #a8edea; text-decoration: none; margin-bottom: 20px; font-size: 0.9rem; }
        .card {
            background: rgba(255,255,255,0.05);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .icon { font-size: 5rem; margin-bottom: 15px; }
        .genre {
            font-size: 1.8rem;
            font-weight: bold;
            margin: 15px 0;
            background: linear-gradient(90deg, #a8edea, #fed6e3);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .desc { color: #aaa; line-height: 1.6; margin: 20px 0; }
        
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }
        .form-group label {
            display: block;
            color: #aaa;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }
        .form-group input {
            width: 100%;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.2);
            background: rgba(0,0,0,0.3);
            color: #fff;
            font-size: 1rem;
            outline: none;
        }
        .form-group input:focus {
            border-color: #a8edea;
        }
        .btn {
            background: linear-gradient(90deg, #a8edea, #fed6e3);
            border: none;
            color: #333;
            padding: 15px 40px;
            border-radius: 30px;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            transition: transform 0.3s;
        }
        .btn:hover { transform: scale(1.02); }
        
        .result-box { display: none; }
        .form-box { display: block; }
        .tips { color: #666; font-size: 0.8rem; margin-top: 15px; text-align: center; }
    </style>
</head>
<body>
    <header><h1>🎵 音乐品味测试</h1></header>
    <div class="container">
        <a href="/test/index.html" class="back-link">← 返回测试中心</a>
        
        <div class="card">
            <!-- 表单填写区域 -->
            <div class="form-box" id="formBox">
                <div class="icon">🎵</div>
                <div class="desc">输入你的姓名，系统将根据姓名生成你的音乐品味类型</div>
                
                <div class="form-group">
                    <label>你的姓名</label>
                    <input type="text" id="nameInput" placeholder="请输入姓名" maxlength="20">
                </div>
                
                <button class="btn" onclick="submitTest()">开始测试</button>
                <div class="tips">每个姓名仅有一次测试结果</div>
            </div>
            
            <!-- 结果展示区域 -->
            <div class="result-box" id="resultBox">
                <div class="icon" id="icon">🎵</div>
                <div class="genre" id="genre"></div>
                <div class="desc" id="desc"></div>
                <div style="color: #666; font-size: 0.85rem; margin-top: 20px; text-align: center;">
                    测试时间：<span id="testTime"></span>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        const music = [
            { emoji: "🎤", name: "流行", desc: "你紧跟潮流，喜欢大众认可的音乐。善于社交，人缘好。", trait: "社交达人" },
            { emoji: "🎸", name: "摇滚", desc: "你内心有反叛精神，追求自由和真实。情感强烈，爱恨分明。", trait: "反叛者" },
            { emoji: "🎷", name: "爵士", desc: "你优雅有品位，喜欢有深度的音乐。懂得享受生活。", trait: "品味家" },
            { emoji: "🎻", name: "古典", desc: "你有内涵有修养，喜欢经典永恒的东西。思维深邃。", trait: "绅士/淑女" },
            { emoji: "🎹", name: "电子", desc: "你现代感强，喜欢创新和未来感。思维活跃，接受新事物快。", trait: "未来派" },
            { emoji: "🪕", name: "民谣", desc: "你内心文艺，喜欢简单真实的声音。重视精神世界。", trait: "文艺青年" },
            { emoji: "🎧", name: "嘻哈", desc: "你个性鲜明，喜欢节奏感和态度音乐。表达欲强。", trait: "表达者" },
            { emoji: "💜", name: "R&B", desc: "你浪漫感性，喜欢有情感的音乐。重视感受和体验。", trait: "浪漫主义者" },
            { emoji: "🌙", name: "轻音乐", desc: "你内心平静，喜欢纯净治愈的声音。善于思考。", trait: "沉思者" },
            { emoji: "🤘", name: "金属", desc: "你充满力量，喜欢激烈有冲击力的音乐。意志坚定。", trait: "硬汉" }
        ];
        
        function getHash(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                const char = str.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash = hash & hash;
            }
            return Math.abs(hash);
        }
        
        function submitTest() {
            const name = document.getElementById('nameInput').value.trim();
            if (!name) {
                alert('请输入姓名');
                return;
            }
            
            const hash = getHash(name);
            const result = music[hash % music.length];
            
            document.getElementById('icon').textContent = result.emoji;
            document.getElementById('genre').textContent = result.emoji + " " + result.name;
            document.getElementById('desc').innerHTML = result.desc + "<br><br><strong>你是：" + result.trait + "</strong>";
            
            document.getElementById('formBox').style.display = 'none';
            document.getElementById('resultBox').style.display = 'block';
            document.getElementById('testTime').textContent = new Date().toLocaleString('zh-CN');
            
            localStorage.setItem('music_test_done', name);
        }
        
        // 检查是否已测试过
        window.onload = function() {
            const done = localStorage.getItem('music_test_done');
            if (done) {
                const hash = getHash(done);
                const result = music[hash % music.length];
                
                document.getElementById('formBox').style.display = 'none';
                document.getElementById('resultBox').style.display = 'block';
                document.getElementById('icon').textContent = result.emoji;
                document.getElementById('genre').textContent = result.emoji + " " + result.name;
                document.getElementById('desc').innerHTML = result.desc + "<br><br><strong>你是：" + result.trait + "</strong>";
            }
        }
    </script>
</body>
</html>