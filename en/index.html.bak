  <script src="../js/shared.js?v=20260319"></script>
  <script>
    function toggleServices() {
      var grid = document.getElementById('services-grid');
      var btn = document.getElementById('btn-expand-services');
      var expanded = grid.classList.toggle('expanded');
      btn.classList.toggle('expanded', expanded);
      btn.innerHTML = expanded
        ? 'Collapse Services <span class="expand-arrow">▲</span>'
        : 'Show More Services <span class="expand-arrow">▼</span>';
    }

    function toggleAIChatWidget() {
      var w = document.getElementById('ai-chat-widget');
      var b = document.getElementById('chat-float-btn');
      if (!w || !b) return;
      var opening = !w.classList.contains('active');
      w.classList.toggle('active', opening);
      b.classList.toggle('hidden', opening);
    }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Yizhai Yiju Feng Shui Consulting",
    "url": "https://12zn.com/en/",
    "description": "Practical feng shui consulting for home, career, and relationships.",
    "areaServed": "US",
    "serviceType": "Feng Shui Consulting"
  }
  </script>
