    <!-- ========== 业务逻辑 ========== -->
    <script>
        let floorplanFile=null;

        function uploadFloorplan(input){
            floorplanFile=input.files[0];
            if(floorplanFile){
                const reader=new FileReader();
                reader.onload=function(e){
                    document.getElementById('floorplan-preview').src=e.target.result;
                    document.getElementById('floorplan-preview').style.display='block';
                };
                reader.readAsDataURL(floorplanFile);
            }
        }

        function analyzeFloorplan(){
            if(!floorplanFile)return alert('请先上传户型Plan');
            const resultDiv=document.getElementById('floorplan-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'Floor Plan分析',message:'请分析这个户型Plan的风水，给出专业建议'})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('','Floor Plan分析报告',data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML('Floor Plan分析');});
        }
        function getColor(){
            const type=document.getElementById('color-room').value;const desc=document.getElementById('color-style').value;
            const resultDiv=document.getElementById('color-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:type,message:desc})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('',type,data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML(type);});
        }
        function getBudget(){
            const type=document.getElementById('budget-area').value;const desc=document.getElementById('budget-style').value;
            const resultDiv=document.getElementById('budget-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:type,message:desc})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('',type,data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML(type);});
        }
        function getStorage(){
            const type=document.getElementById('storage-room').value;const desc=document.getElementById('storage-family').value;
            const resultDiv=document.getElementById('storage-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:type,message:desc})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('',type,data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML(type);});
        }
        function submitStyle(){
            const type=document.getElementById('style-room').value;const desc=document.getElementById('style-desc').value;
            const resultDiv=document.getElementById('style-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:type,message:desc})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('',type,data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML(type);});
        }
        function getLight(){
            const stage=document.getElementById('light-room').value;const concern=document.getElementById('light-orientation').value;
            const desc=document.getElementById('light-description').value;
            const resultDiv=document.getElementById('light-result');showLoadingInResult(resultDiv);
            fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:concern+'(Renovation Feng Shui)',message:desc||stage})})
            .then(r=>r.json()).then(data=>{resultDiv.innerHTML=buildResultHTML('',concern,data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈');})
            .catch(()=>{resultDiv.innerHTML=buildErrorHTML(concern);});
        }

        function submitTalisman(){
            const type=document.getElementById('talisman-type').value;
            const name=document.getElementById('talisman-name').value;
            const birth=document.getElementById('talisman-birth').value;
            const wechat=document.getElementById('talisman-wechat').value;
            if(!name||!wechat)return alert('请填写姓Name和微信');
            showLoading();
            fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,phone:wechat,type:'Talisman Items - '+type,message:'出生: '+birth,source:'Talisman Items'})})
            .then(r=>r.json()).then(data=>{
                hideLoading();
                if(data.success){
                    showResult('talisman-result','<h4>✅ 请Talisman已提交</h4><p style="color:var(--text-secondary);font-size:0.85rem;margin-top:10px;">Talisman咒需要根据您的信息定制，我们将在24小时内通过微信与您确认详Love。</p>');
                    document.getElementById('talisman-name').value='';document.getElementById('talisman-birth').value='';document.getElementById('talisman-wechat').value='';
                } else {
                    showResult('talisman-result','<h4>提交失败</h4><p style="color:var(--vermilion);font-size:0.85rem;">'+( data.error||'请稍后重试')+'</p>');
                }
            }).catch(()=>{
                hideLoading();
                showResult('talisman-result','<h4>网络错误</h4><p style="color:var(--vermilion);font-size:0.85rem;">请检查网络后重试</p>');
            });
        }
        function submitSupport(){
            const name=document.getElementById('support-name').value;
            const wechat=document.getElementById('support-wechat').value;
            const type=document.getElementById('support-type').value;
            const desc=document.getElementById('support-desc').value;
            if(!name||!wechat||!desc)return alert('请填写完整信息');
            showLoading();
            fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,phone:wechat,type:type,message:desc,source:'Book Consultation'})})
            .then(r=>r.json()).then(data=>{
                hideLoading();
                if(data.success){
                    showResult('support-result','<h4>✅ 咨询已提交</h4><p style="color:var(--text-secondary);font-size:0.85rem;margin-top:10px;">感谢您的信任！我们将在24小时内通过微信与您Contact。</p>');
                    document.getElementById('support-name').value='';document.getElementById('support-wechat').value='';document.getElementById('support-desc').value='';
                } else {
                    showResult('support-result','<h4>提交失败</h4><p style="color:var(--vermilion);font-size:0.85rem;">'+(data.error||'请稍后重试')+'</p>');
                }
            }).catch(()=>{
                hideLoading();
                showResult('support-result','<h4>网络错误</h4><p style="color:var(--vermilion);font-size:0.85rem;">请检查网络后重试</p>');
            });
        }
    </script>

    <!-- 悬浮按钮 -->
    <button class="fab-chat" id="chat-float-btn" onclick="toggleAIChatWidget()">
        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
    </button>
    <div class="fab-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</div>

    <!-- AI聊天窗口 -->
    <div class="chat-widget" id="ai-chat-widget">
        <div class="chat-container">
            <div class="chat-head">
                <span class="chat-head-title">Yizhai Yiju · AI风水助手</span>
                <span class="chat-head-close" onclick="toggleAIChatWidget()">✕</span>
            </div>
            <div class="chat-body" id="chat-messages-widget">
                <div class="chat-msg bot">您好，我是「Yizhai Yiju」AI风水助手。<br>新用户可<strong>Free3次</strong>提问。解锁体验包（¥99）：1 Deep Report + 3 Follow-ups within 48 hours。</div>
                <div class="chat-quick">
                    <button onclick="quickAsk('我想算算WealthFortune')">WealthFortune</button>
                    <button onclick="quickAsk('我想看姻Love')">姻Love</button>
                    <button onclick="quickAsk('帮我看看房子')">房子</button>
                    <button onclick="quickAsk('犯太岁怎么办')">太岁</button>
                </div>
            </div>
            <div class="chat-foot">
                <input id="chat-input" type="text" placeholder="输入您的风水问题..." onkeypress="if(event.key==='Enter')sendChatMessage()">
                <button onclick="sendChatMessage()">发送</button>
            </div>
        </div>
    </div>

    <script>
    let chatHistory=[];
    function toggleAIChatWidget(){
        const w=document.getElementById('ai-chat-widget');const b=document.getElementById('chat-float-btn');
        if(!w.classList.contains('active')){w.classList.add('active');b.style.display='none';}
        else{w.classList.remove('active');b.style.display='flex';}
    }
    function quickAsk(q){document.getElementById('chat-input').value=q;sendChatMessage();}
    function appendChatText(container, role, text){
        const el = document.createElement('div');
        el.className = 'chat-msg ' + role;
        el.textContent = text || '';
        container.appendChild(el);
        return el;
    }
    function appendChatHtml(container, role, html){
        const el = document.createElement('div');
        el.className = 'chat-msg ' + role;
        el.innerHTML = html;
        container.appendChild(el);
        return el;
    }
    function showPaywallPrompt(container){
        appendChatHtml(container, 'bot', '您已用完Free提问次数。<br><br>解锁 <strong>AI Deep Analysis Experience Pack</strong>：<br>1 Deep Report + 3 Follow-ups within 48 hours，仅 <strong>¥99</strong><br><br><button onclick="openPayModal(\'ai_deep\')" style="background:var(--gold);border:none;padding:8px 18px;border-radius:6px;color:var(--white);font-weight:500;cursor:pointer;">支付¥99解锁</button>');
        container.scrollTop=container.scrollHeight;
    }

    function getAiDeepPaidState(){
        try{
            const map = JSON.parse(localStorage.getItem('paid_products') || '{}');
            const rec = map.ai_deep;
            if(!rec || !rec.paid_at) return false;
            const paidAt = new Date(rec.paid_at).getTime();
            if(!Number.isFinite(paidAt)) return false;
            return (Date.now() - paidAt) <= (48 * 60 * 60 * 1000);
        }catch(e){
            return false;
        }
    }

    function markAiDeepPaidLocal(source, orderNo, amount){
        try{
            const map = JSON.parse(localStorage.getItem('paid_products') || '{}');
            map.ai_deep = {
                paid_at: new Date().toISOString(),
                order_no: orderNo || '',
                amount: amount || '99.00',
                source: source || 'index'
            };
            localStorage.setItem('paid_products', JSON.stringify(map));
            localStorage.setItem('unlock_ai_deep', 'true');
            localStorage.setItem('aiPaid', 'true');
        }catch(e){}
    }

    let chatCount=parseInt(localStorage.getItem('aiChatCount')||'0');
    let isPaid=getAiDeepPaidState();
    (async function syncPaidStatus(){
        const user=getUser();
        if(user&&user.id&&supabaseClient){
            try{const{data}=await supabaseClient.from('users').select('is_paid').eq('id',user.id).single();
            if(data&&data.is_paid){markAiDeepPaidLocal('supabase_sync','','99.00');isPaid=true;}}catch(e){}
        }
    })();
    localStorage.setItem('aiChatCount',chatCount);

    function sendChatMessage(){
        const input=document.getElementById('chat-input');const msg=input.value.trim();if(!msg)return;
        const ms=document.getElementById('chat-messages-widget');
        const user = getUser();
        const userId = user && user.id ? String(user.id) : '';
        appendChatText(ms, 'user', msg);input.value='';
        const thinkingEl = appendChatText(ms, 'bot', (chatCount>=3)?'深度分析中...':'思考中...');
        thinkingEl.id = 'chat-thinking';
        ms.scrollTop=ms.scrollHeight;
        chatHistory.push({role:'user',content:msg});

        fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'对话咨询',message:msg,history:chatHistory,user_id:userId})})
        .then(async (r)=>{
            const data = await r.json().catch(()=>({}));
            return { ok:r.ok, status:r.status, data:data };
        }).then(({ok,status,data})=>{
            const el=document.getElementById('chat-thinking');if(el)el.remove();
            if(!ok){
                if(status===402||data.requires_payment){
                    chatCount=Math.max(chatCount,3);localStorage.setItem('aiChatCount',chatCount);
                    showPaywallPrompt(ms);
                    return;
                }
                appendChatText(ms, 'bot', data.error||'网络问题，请稍后再试。');ms.scrollTop=ms.scrollHeight;
                return;
            }
            const answer=data.answer||data.reply||'抱歉，AI正在休息，请加微信详谈';
            appendChatText(ms, 'bot', answer);
            if(data.quota){
                if(data.quota.paid){isPaid=true;}
                if(Number.isFinite(data.quota.used)){chatCount=data.quota.used;localStorage.setItem('aiChatCount',chatCount);}
            }else{
                chatCount++;localStorage.setItem('aiChatCount',chatCount);
            }
            chatHistory.push({role:'assistant',content:answer});ms.scrollTop=ms.scrollHeight;
        }).catch(()=>{
            const el=document.getElementById('chat-thinking');if(el)el.remove();
            appendChatText(ms, 'bot', '网络问题，请稍后再试。');ms.scrollTop=ms.scrollHeight;
        });
    }
    </script>

    <!-- 支付逻辑 -->
    <script>
    let currentOrderNo = null;
    let payCheckTimer = null;
    function sanitizeProductId(value){
        return String(value || '').replace(/[^a-zA-Z0-9_-]/g, '');
    }
    function escapePayHTML(value){
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // 打开支付弹窗（可指定Business品或显示选择列表）
    function openPayModal(productId) {
        const modal = document.getElementById('modal-pay');
        modal.classList.add('active');
        if (productId) {
            createOrder(productId);
        } else {
            showProductList();
        }
    }

    function closePayModal() {
        document.getElementById('modal-pay').classList.remove('active');
        if (payCheckTimer) { clearInterval(payCheckTimer); payCheckTimer = null; }
        currentOrderNo = null;
        // 重置步骤
        document.getElementById('pay-step-select').style.display = 'block';
        document.getElementById('pay-step-qr').style.display = 'none';
        document.getElementById('pay-step-success').style.display = 'none';
    }

    function backToProducts() {
        if (payCheckTimer) { clearInterval(payCheckTimer); payCheckTimer = null; }
        document.getElementById('pay-step-qr').style.display = 'none';
        document.getElementById('pay-step-select').style.display = 'block';
        showProductList();
    }

    // 显示Business品列表
    async function showProductList() {
        const list = document.getElementById('pay-product-list');
        list.innerHTML = '<p style="text-align:center;color:var(--text-secondary);">加载中...</p>';
        try {
            const res = await fetch('/api/pay/products');
            const data = await res.json();
            let html = '';
            data.products.forEach(function(p) {
                const id = sanitizeProductId(p.id);
                if(!id) return;
                const name = escapePayHTML(p.name);
                const desc = escapePayHTML(p.desc);
                const price = escapePayHTML(p.price);
                html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:14px;margin-bottom:10px;background:var(--cream);border:1px solid var(--border-soft);border-radius:10px;cursor:pointer;transition:border-color 0.2s;" onclick="createOrder(\'' + id + '\')" onmouseover="this.style.borderColor=\'var(--gold)\'" onmouseout="this.style.borderColor=\'var(--border-soft)\'">' +
                    '<div><div style="font-weight:500;font-size:0.95rem;color:var(--ink);">' + name + '</div>' +
                    '<div style="font-size:0.8rem;color:var(--text-secondary);margin-top:3px;">' + desc + '</div></div>' +
                    '<div style="font-size:1.1rem;font-weight:600;color:var(--gold);white-space:nowrap;margin-left:12px;">¥' + price + '</div></div>';
            });
            list.innerHTML = html;
        } catch(e) {
            list.innerHTML = '<p style="text-align:center;color:var(--vermilion);">加载失败，请稍后重试</p>';
        }
    }

    // 创建订单
    async function createOrder(productId) {
        document.getElementById('pay-step-select').style.display = 'none';
        document.getElementById('pay-step-qr').style.display = 'block';
        document.getElementById('pay-qr-img').src = '';
        document.getElementById('pay-order-info').textContent = '正在生成支付2维码...';
        document.getElementById('pay-amount-display').textContent = '';
        document.getElementById('pay-status-msg').style.display = 'none';

        try {
            const res = await fetch('/api/pay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ product_id: productId })
            });
            const data = await res.json();

            if (data.success) {
                currentOrderNo = data.order_no;
                document.getElementById('pay-qr-img').src = data.qr_code;
                document.getElementById('pay-order-info').textContent = data.subject + ' · 订单号: ' + data.order_no;
                document.getElementById('pay-amount-display').textContent = '¥' + data.amount;

                // 自动轮询支付状态（每3秒）
                payCheckTimer = setInterval(function() { checkPayStatus(true); }, 3000);
            } else {
                document.getElementById('pay-order-info').textContent = '';
                var msg = document.getElementById('pay-status-msg');
                msg.style.display = 'block';
                msg.style.background = 'var(--vermilion-soft)';
                msg.style.color = 'var(--vermilion)';
                msg.textContent = data.error || data.detail || '创建订单失败，请稍后重试';
            }
        } catch(e) {
            document.getElementById('pay-order-info').textContent = '';
            var msg = document.getElementById('pay-status-msg');
            msg.style.display = 'block';
            msg.style.background = 'var(--vermilion-soft)';
            msg.style.color = 'var(--vermilion)';
            msg.textContent = '网络错误，请稍后重试';
        }
    }

    // 检查支付状态
    async function checkPayStatus(silent) {
        if (!currentOrderNo) return;
        try {
            const res = await fetch('/api/pay/status?order_no=' + currentOrderNo);
            const data = await res.json();
            if (data.status === 'paid') {
                // 支付成功
                if (payCheckTimer) { clearInterval(payCheckTimer); payCheckTimer = null; }
                document.getElementById('pay-step-qr').style.display = 'none';
                document.getElementById('pay-step-success').style.display = 'block';
                document.getElementById('pay-success-msg').textContent = '支付成功，已解锁 AI 深度分析体验包。您现在可使用：1 Deep Report + 3 Follow-ups within 48 hours。';

                // 如果是AI深度分析，解锁
                markAiDeepPaidLocal('index_pay', currentOrderNo, data.amount || '99.00');
                isPaid = true;
            } else if (!silent) {
                var msg = document.getElementById('pay-status-msg');
                msg.style.display = 'block';
                msg.style.background = 'var(--gold-bg)';
                msg.style.color = 'var(--text)';
                msg.textContent = '暂未检测到支付，请确认已完成扫码付款';
                setTimeout(function() { msg.style.display = 'none'; }, 3000);
            }
        } catch(e) {
            if (!silent) {
                var msg = document.getElementById('pay-status-msg');
                msg.style.display = 'block';
                msg.style.background = 'var(--vermilion-soft)';
                msg.style.color = 'var(--vermilion)';
                msg.textContent = '查询失败，请稍后再试';
            }
        }
    }

    // Click outside popup to close
    document.getElementById('modal-pay').addEventListener('click', function(e) {
        if (e.target === this) closePayModal();
    });
    </script>
</body>
</html>
