    <script>
    // Service cards collapse/展开
    function toggleServices(){
        const grid = document.getElementById('services-grid');
        const btn = document.getElementById('btn-expand-services');
        const expanded = grid.classList.toggle('expanded');
        btn.classList.toggle('expanded', expanded);
        btn.innerHTML = expanded
            ? 'Collapse Services <span class="expand-arrow">▼</span>'
            : 'Show More Services <span class="expand-arrow">▼</span>';
    }

    const chatCountEl = document.getElementById('chat-count-display');
    if(chatCountEl){
        fetch('/api/stats').then(r=>r.json()).then(d=>{
            chatCountEl.textContent='Today Messages: '+d.count+'条';
        }).catch(()=>{});
    }

    // Click outside popup to close
    document.querySelectorAll('.modal').forEach(modal=>{
        modal.addEventListener('click',function(e){if(e.target===this)this.classList.remove('active');});
    });
    </script>

